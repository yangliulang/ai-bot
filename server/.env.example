# ChainUp Agent API — example environment (never commit secrets)
CHAINUP_AGENT_ENV=development
CHAINUP_AGENT_DEBUG=true

# Listen (uvicorn cli can override via --host/--port)
CHAINUP_AGENT_API_HOST=0.0.0.0
CHAINUP_AGENT_API_PORT=8080

# JSON logs on stdout when false (default); true = human-readable
CHAINUP_AGENT_LOG_JSON=false

# Async SQLAlchemy URL — dev: aiosqlite; prod: postgresql+asyncpg://...
# 默认库文件在 server/db/（工作目录为 server/ 时相对路径）；部署时可改为绝对路径或挂载卷
CHAINUP_AGENT_DATABASE_URL=sqlite+aiosqlite:///./db/chainup_agent.sqlite3
# 仅 ORM create_all、无迁移数据时可选：空 Provider 目录在 GET /admin/ai 时自动写入 demo（默认 false，删除后刷新不会「复活」demo）
# CHAINUP_AGENT_ADMIN_AI_CATALOG_SEED_DEMO_IF_EMPTY=true
# Confirm 落库前须执行：`cd server && uv run alembic upgrade head`（见 migration **`0002_tatb`**、`0003_ai`）。
# Bindings：`telegram_agent_trading_binding`（Fernet 密封存 api_key / secret_key）；实例：`agent_instance`（每 Telegram 用户一行）。
# 生成密钥：PYTHON -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# CHAINUP_AGENT_BINDING_SECRETS_FERNET_KEY=

# HTTPS 起始（末尾一般不要 /）。本地联调推荐：单一 ngrok 指向 ../deeplink 的 **5174**，`PUBLIC_BASE_URL` 与同域的
# BIND_PAGE_URL 对齐（见 README 与 `ngrok.chainupEndpoints.example.yml`；Vite 代理 /webhook → Agent8080）。
CHAINUP_AGENT_PUBLIC_BASE_URL=https://your-tunnel.example.com

# Telegram Bot API token (BotFather — dev/test). Never commit; rotate if leaked.
# CHAINUP_AGENT_TELEGRAM_BOT_TOKEN=

# Bot 回填 + 「前往绑定页」按钮。常与 PUBLIC_BASE_URL **同主机**，可写带尾 /
# ngrok+Vite5174：https://your-tunnel.ngrok-free.app/
# 请勿让「同源双隧道」同时直连 8080 与 5174，避免出现点击链接却打开 FastAPI 的问题。
# CHAINUP_AGENT_TELEGRAM_BIND_PAGE_URL=http://localhost:5174/
# 生产或由主站/BFF 托管时请用产品在 design/api 中冻结的路径 — 勿臆造正式域名。
# CHAINUP_AGENT_TELEGRAM_BIND_PAGE_URL=https://exchange.example/agent/telegram-bind

# 联调：逗号分隔的 Telegram chat_id，简化回执；与 DB 绑定命中 **并存**。
# CHAINUP_AGENT_TELEGRAM_BOUND_CHAT_ALLOWLIST=
# 兼容旧名：CHAINUP_AGENT_TELEGRAM_BOUND_CHAT_ALLOWLIST（与新名二选一即可）

# Webhook：默认 false —— 验 token 后立刻 200，再在 BackgroundTasks 里 sendMessage（避免 Telegram 等太久）。
# 若部署在「返回响应后不再执行后台任务」的环境（如无服务器冻结），设为 true 在同请求内处理（ACK 会变慢）。
# CHAINUP_AGENT_TELEGRAM_WEBHOOK_INLINE_PROCESSING=true

# Telegram 错误话术：true 时对部分现货拒单等 AppError 经 Admin AI LLM 改写为友好中文（失败则用原文案）。
# CHAINUP_AGENT_TELEGRAM_ERROR_LLM_REWRITE=true
# CHAINUP_AGENT_TELEGRAM_ERROR_LLM_TIMEOUT_SEC=15
# 兜底话术是否附带「（编排预览）粗略意图」调试行；生产建议 false（默认）
# CHAINUP_AGENT_TELEGRAM_INTENT_PREVIEW_IN_REPLY=false
# Telegram：read.market.ticker 只读成功后追加一次 Prompt Assembly LLM（runtime_context.exchangeReadPreview）；失败则仍为确定性 ticker 摘要。须迁移 0014 种子包以获得 TRADING 场景正文（无包则用代码回退）。
# CHAINUP_AGENT_TELEGRAM_LLM_NARRATE_READ_MARKET_TICKER=false
# Telegram：read.market.depth / read.market.trades 只读成功后各可选 Assembly LLM；须迁移 0015。
# CHAINUP_AGENT_TELEGRAM_LLM_NARRATE_READ_MARKET_DEPTH=false
# CHAINUP_AGENT_TELEGRAM_LLM_NARRATE_READ_MARKET_TRADES=false
# CHAINUP_AGENT_FEATURE_AGENT_FUTURES=true
# CHAINUP_AGENT_FEATURE_AGENT_MARGIN=true
# Telegram：合约 Type-A 确认前可选 LLM preamble（须迁移 0023 TRADING 包）
# CHAINUP_AGENT_TELEGRAM_LLM_NARRATE_FUTURES_MARKET_CONFIRM=false
# CHAINUP_AGENT_TELEGRAM_LLM_NARRATE_FUTURES_LIMIT_CONFIRM=false
# CHAINUP_AGENT_TELEGRAM_LLM_NARRATE_READ_ACCOUNT_BALANCE=false
# CHAINUP_AGENT_TELEGRAM_LLM_NARRATE_WEALTH_HOLDINGS_READ=false

# 意图 NLU：true 时走 Admin 网关 LLM JSON（失败自动回退关键词）；超时见 INTENT_NLU_LLM_TIMEOUT_SEC
# CHAINUP_AGENT_INTENT_NLU_USE_LLM=false
# CHAINUP_AGENT_INTENT_NLU_LLM_TIMEOUT_SEC=25

# Telegram 闲聊（chat.faq）；
# 路由：Provider baseUrl 主机含 volces.com → POST …/api/v3/responses；否则 …/chat/completions。
# CHAINUP_AGENT_LLM_FALLBACK_API_KEY=

# Optional: web admin (`admin/`) — default env mode: single operator from env (pair; empty = login 503)
CHAINUP_AGENT_ADMIN_CONSOLE_AUTH_MODE=env
CHAINUP_AGENT_ADMIN_PANEL_USERNAME=杨六郎
CHAINUP_AGENT_ADMIN_PANEL_PASSWORD=123321
# 生产/共享环境建议启用（≥16 字符）：登录 access_token 为 JWT；所有 /api/v1/admin/* 须 Authorization: Bearer
# CHAINUP_AGENT_ADMIN_CONSOLE_JWT_SECRET=please-change-min-16-chars__
# CHAINUP_AGENT_ADMIN_CONSOLE_ACCESS_TOKEN_TTL_SECONDS=43200
# database 模式：`alembic upgrade head`；首张：`POST /api/auth/register`（空库、password≥8）或 seed CLI。
# CHAINUP_AGENT_ADMIN_CONSOLE_OPEN_REGISTRATION=false
# （true：允许在已有管理员后再注册）
# `uv run chainup-agent-seed-admin --username ... --password ...`

# CHAINUP_AGENT_DEFAULT_AGENT_TEMPLATE_ID=tmpl_agent_default
# CHAINUP_AGENT_DEFAULT_AGENT_TEMPLATE_VERSION=1

# 运行时脚手架：全局关停 / 运维暂停（POST /api/v1/agent/access/evaluate 读取）
# CHAINUP_AGENT_AGENT_RUNTIME_GLOBAL_DISABLED=false
# CHAINUP_AGENT_AGENT_RUNTIME_OPS_SUSPENDED=false
# CHAINUP_AGENT_ADMIN_CONSOLE_AUTH_MODE=database
