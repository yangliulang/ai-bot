# -----------------------------------------------------------------------------
# ChainUp Agent API · 线上环境模板（dw2nn.com）
#
# 使用方式（进程固定读取 server/.env，见 chainup_agent/core/config.py）：
#   1. 将本文件内容合并/覆盖到 server/.env（或 cp .env.online.example .env 后改占位符）
#   2. 填写 REPLACE_* / 数据库 / 密钥（勿将含密钥的 .env 提交 Git）
#   3. 在 server/ 目录：uv run chainup-agent-api
#      生产亦可用 systemd / K8s 注入同名 CHAINUP_AGENT_* 环境变量替代 .env 文件。
#
# Admin SPA：https://botadmin.dw2nn.com/
# Deeplink H5：https://deeplink.dw2nn.com/
#
# PUBLIC_BASE_URL：须与 Telegram Webhook 实际落到的 HTTPS 根一致（末尾一般不加 /）。
#   若 Ingress 把 /webhook、/api 反代到本服务且对外主机为 deeplink，则用 deeplink；
#   若单独 api.* 域名直连 Agent，则改为该域名。
# -----------------------------------------------------------------------------

CHAINUP_AGENT_ENV=production
CHAINUP_AGENT_DEBUG=false

CHAINUP_AGENT_API_HOST=0.0.0.0
CHAINUP_AGENT_API_PORT=8080
CHAINUP_AGENT_LOG_JSON=false

# 生产必须使用 Postgres（示例 URL；替换用户、口令、库名、主机）
CHAINUP_AGENT_DATABASE_URL=sqlite+aiosqlite:///./db/chainup_agent.sqlite3
# CHAINUP_AGENT_DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_PG_HOST:5432/REPLACE_DBNAME

# Confirm / bindings：Fernet.generate_key().decode()，一经用于加密请勿随意更换
CHAINUP_AGENT_BINDING_SECRETS_FERNET_KEY=r68iIBJWB8di2Ev1x_vNQR5gTANiB79aIriIMTFPab0=

# Webhook 注册根 URL（示例：Webhook 经 deeplink 同域反代到 Agent）
CHAINUP_AGENT_PUBLIC_BASE_URL=https://deeplink.dw2nn.com

CHAINUP_AGENT_TELEGRAM_BOT_TOKEN=8944674236:AAFs1wwOVmemdPxYwiBOsHub8hw7oRdGELQ

# 用户点击「前往绑定」的 Deeplink 入口（可与 PUBLIC_BASE_URL 同主机）
CHAINUP_AGENT_TELEGRAM_BIND_PAGE_URL=https://deeplink.dw2nn.com/

# 生产勿放开 假绑定名单（留空）
CHAINUP_AGENT_TELEGRAM_BOUND_CHAT_ALLOWLIST=

# Serverless / 响应返回后进程冻结时再考虑 true（默认 BackgroundTasks）
# CHAINUP_AGENT_TELEGRAM_WEBHOOK_INLINE_PROCESSING=false

# NLU / LLM（按容量与成本）
CHAINUP_AGENT_INTENT_NLU_USE_LLM=true
# CHAINUP_AGENT_INTENT_NLU_LLM_TIMEOUT_SEC=25

# 闲聊兜底 Key（可选；优先 Admin Provider.secretRef）
# CHAINUP_AGENT_LLM_FALLBACK_API_KEY=

# 现货 Type-A 确认前可选 LLM 风险提示（默认 false；确定性确认块始终保留）
# CHAINUP_AGENT_TELEGRAM_LLM_NARRATE_SPOT_FLASH_CONFIRM=false
# CHAINUP_AGENT_TELEGRAM_LLM_NARRATE_SPOT_LIMIT_CONFIRM=false

# 限价偏离最新价护栏（默认 false；开启后 Telegram 在 Type-A 确认按钮出现前即校验）
# CHAINUP_AGENT_TRADE_SPOT_LIMIT_PRICE_BAND_ENABLED=false
# CHAINUP_AGENT_TRADE_SPOT_LIMIT_PRICE_BAND_MAX_PCT=15

# Admin：env 单账号（或与 database 模式二选一）
CHAINUP_AGENT_ADMIN_CONSOLE_AUTH_MODE=env
CHAINUP_AGENT_ADMIN_PANEL_USERNAME=chainup-ai-bot-admin
CHAINUP_AGENT_ADMIN_PANEL_PASSWORD=1q2w3e4r

# 必填 ≥16 字符；JWT 签发后勿频繁轮换以免全员重新登录。（下行为文档示例占位，上线必须从仓库外注入并由 `openssl rand -hex 32` 或 KMS 另行生成）
CHAINUP_AGENT_ADMIN_CONSOLE_JWT_SECRET=tTzV2mWiKr4q8daPLStLZOwYg95Yhm8K8ayX9PBCBsr_0lzSv2hKjzlTvYVw2R__
CHAINUP_AGENT_ADMIN_CONSOLE_ACCESS_TOKEN_TTL_SECONDS=43200

# database 模式时：首张注册 / OPEN_REGISTRATION 见 BACKEND_SPEC
# CHAINUP_AGENT_ADMIN_CONSOLE_AUTH_MODE=database
# CHAINUP_AGENT_ADMIN_CONSOLE_OPEN_REGISTRATION=false

# 勿在线上依赖运行时注入 demo 目录（迁移 0004 已种子）
CHAINUP_AGENT_ADMIN_AI_CATALOG_SEED_DEMO_IF_EMPTY=false
