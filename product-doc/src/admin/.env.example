# 复制为 .env.development 本地使用（不要提交含密钥的 .env）

# Prompt Management API 根 URL（须包含协议，无尾随斜杠；与 openapi servers 替换一致）
VITE_API_BASE_URL=

# 为 true 时：列表/详情/编辑器走 `/api/v1/admin/prompt-packs*`；
#   - 列表成功但缺包 → 以 mock 补齐 16 治理包（remote+mock-ssot）
#   - 请求失败 → 整表回退 mock（remote+fallback）
VITE_USE_PROMPT_API=false

# 为 true 时：执行记录页走 `GET /api/v1/admin/observability/executions`（须同上 VITE_API_BASE_URL）；未开启则用本地 mock
VITE_USE_OBSERVABILITY_API=false

# 为 true 时：Commerce 运营页走 `GET /api/v1/admin/billing/commerce/*`（须配置 VITE_API_BASE_URL）
# 本地 dev：npm run dev 已内置 BFF mock（同窗 OpenAPI），示例：
#   VITE_API_BASE_URL=http://localhost:5174
#   VITE_USE_BILLING_COMMERCE_API=true
VITE_USE_BILLING_COMMERCE_API=false

# 为 true 时：执行核销追踪走 `GET /api/v1/admin/billing/traces`（须配置 VITE_API_BASE_URL）
# 本地 dev BFF mock 同窗 mockBillingLedger
VITE_USE_BILLING_LEDGER_API=false

# 为 true 时：技能规范走 HTTP API（须配置 VITE_API_BASE_URL）
# 本地 dev：npm run dev 已内置 BFF mock（同窗 OpenAPI），示例：
#   VITE_API_BASE_URL=http://localhost:5174
#   VITE_USE_SKILL_API=true
VITE_USE_SKILL_API=false

# --- 以下仅供对齐 contract-closure / billing §12.1（CC-P0-03）；Demo 可不配 ---
# 所内生产须由运维/BFF 终裁真实 scheme+host；OpenAPI `servers.url` 仍为占位，不在此写死生产地址。
# VITE_ADMIN_BFF_BASE_URL=           # 聚合运营 BFF，映射 admin/* + 部分 me/* 视架构而定
# VITE_USER_BILLING_API_BASE_URL=    # user/billing-me 一线（若与上分离）
# VITE_INTERNAL_BILLING_BASE_URL=    # internal/billing-token + billing-entitlements 一线（仅服务端/BFF，勿进浏览器）
# PHASE2_COMMERCE_RAILS_ENABLED=false # 轨 B S2/S5；所内 BFF 读取（非 VITE_ 前缀）
